{
  "name": "release-forms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/verify-production-artifact.mjs",
    "test:security": "node --test supabase/migrations/security-release-remediation.test.mjs src/lib/supabase.security.test.mjs src/hosting-security.test.mjs",
    "ci:secrets": "node scripts/ci/scan-current-tree-credentials.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
}
